<?xml version='1.0'?>
<!--
	SetupCollector config for gnssOptimization (GNSS Positioning).

	dev= is relative to $HOME - "GNSSOptimization/Implementation" means
	$HOME/GNSSOptimization/Implementation, i.e. the folder that actually
	contains res/. SetupCollector reads res/DevRes.xml from this exact
	folder and pulls in everything DevRes.xml references, so dev= MUST
	point at the folder that directly contains res/, not the repo root.
	This does NOT have to match wherever you develop locally in Visual Studio -
	it's only the path the collector (and CI) use internally. CI creates the
	repo-root symlink automatically; for a local Linux/macOS build, clone or
	symlink the repo to $HOME/GNSSOptimization first (Implementation/ is a
	real subfolder inside it, so no extra symlink is needed for that part).

	out= is "gnssOptimization" - must match executableName exactly (case
	included) or dpkg-deb fails on Linux with "failed to open package info file".
-->
<SetupCollector xmlns:win="windows" xmlns:mac="macOS" xmlns:lin="linux" executableName="gnssOptimization">

	<Folders dev="~GNSSOptimization/Implementation"
			 executable="$RAMDisk/Out/GNSSOptimization/Release"
			 out="$RAMDisk/Setup/gnssOptimization"/>

	<Packages debug="false">
		<!-- covers mainUtils + dataProvider + natGUI -->
		<Package name="natGUIALL"/>

		<!-- confirmed from ~/natID.SDK/DevEnv/SetupCollectors listing -->
		<Package name="Matrix"/>

		<!-- GTK runtime is bundled into the Windows installer only -
		     Linux/macOS declare it as a real package dependency instead (see
		     lin:depends below) rather than bundling a duplicate copy. -->
		<Package name="GTK4" exclude="macOS,linux"/>
	</Packages>

	<ResData>
		<Res type="folder" dev="$MyBin/GTK/release/share/glib-2.0/schemas" dep="schemas" exclude="macOS,linux"/>
	</ResData>

	<MutableResource/>

	<Setup licenseFileName="~natID.SDK/DevEnv/License.txt"
			categories="Education;Science"
			win:programGroup="GNSSOptimization"
			win:width="440"
			win:headerBackColor="#12203A"
			win:headerTxtColor="#40D6C8"
			win:licenseTxtColor="#846060"
			win:useMakeCabinet="true"
			win:minBuildNumber="17763"
			lin:depends="$DepGTKv4"
			lin:icon="$HOME/GNSSOptimization/Implementation/res/appIcon/gnssOptimization"/>
</SetupCollector>
